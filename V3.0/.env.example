# V3.0 环境配置模板(复制为 .env 填实际值;.env 不入 git)
# V3.0 = 纯 QQ 号项目(OneBot/NapCat);官方机器人在 V2.0 项目独立演进

# OneBot 反向WS鉴权(与 NapCat 配置的 access_token 一致)
ONEBOT_WS_TOKEN=v3test-token
# 接管对话的 QQ 号(NapCat 登录的号;其他连入号事件忽略+不占出站)
ONEBOT_SELF_ID=1145077465
# 后台维护循环(mood 衰减/记忆遗忘;独立 Redis 自跑)
BACKGROUND_MAINTENANCE=true

# Redis(本栈独立容器,compose 网络 alias "redis";数据与 V2.0 完全隔离)
REDIS_URL=redis://redis:6379/0

# 面板访问 token(X-Access-Token)
ACCESS_TOKEN=114507xX

# LLM
CHAT_PROVIDER=deepseek
DEEPSEEK_API_KEY=填你的key
GLM_API_KEY=填你的key
REVERSE_INFER_PROVIDER=deepseek

# GPT-SoVITS 语音(TTS;经宿主机 frp)
TTS_PROVIDER=gptsovits
GPTSOVITS_API_BASE=http://host.docker.internal:9880
GPTSOVITS_GPT_MODEL=GPT_weights_v2ProPlus/dania.ckpt
GPTSOVITS_SOVITS_MODEL=SoVITS_weights_v2ProPlus/dania.pth
GPTSOVITS_REF_AUDIO=ref/清浔.wav
GPTSOVITS_PROMPT_TEXT=填参考音频文本
