# MyChat Git 忽略规则
# 作者: 李文煜
# 日期: 2026-06-15

# 环境与密钥（绝不入库）
.env
*.key
*.pem

# 数据库与运行时数据
*.db
*.sqlite
*.sqlite3
data/
server/data/

# 用户上传资源（头像/人设图/表情包/背景）
server/data/static/uploads/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node / 前端构建
node_modules/
dist/
server/dashboard/dist/
server/dashboard/node_modules/

# 打包产物
build/
release/
*.spec

# IDE（保留 .claude 项目配置，忽略本地权限覆盖与 IDE 私有配置）
.idea/
.vscode/
.claude/settings.local.json
.claude/chat.md
.claude/memory_path.txt

# 操作系统
.DS_Store
Thumbs.db

# 日志
*.log
logs/

# 参考资料（仅本地：含大体积样本 APK 与 persona 样本，不入库）
Ref/
