# MyChat 环境变量模板
# 作者: 李文煜
# 日期: 2026-06-15
# 说明: 复制为 .env 并填入真实值；.env 不入库（见 .gitignore）

# ===== 服务端 =====
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# 单人场景访问令牌（WS query 与 REST Bearer 鉴权用）
ACCESS_TOKEN=change-me-please

# ===== Redis（云端 Docker）=====
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ===== LLM Providers（按需填写，对应 F-C-03）=====
GLM_API_KEY=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
LMARENA_API_KEY=

# ===== 多模态服务（M6 阶段填充，对应 F-C-07 / F-P-01~03）=====
TTS_API_KEY=
ASR_API_KEY=
IMAGE_GEN_API_KEY=

# ===== 客户端（指向服务端，重装系统后请确认服务器实际 IPv4）=====
CLIENT_SERVER_URL=http://<服务器IPv4>:8000
CLIENT_WS_URL=ws://<服务器IPv4>:8000/ws
