# MyChat 环境变量模板
# 作者: 李文煜
# 日期: 2026-06-23
# 说明: 复制为 .env 并填入真实值；.env 不入库（见 .gitignore）

# ===== 服务端 =====
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# 单人场景访问令牌（WS query 与 REST Header/Query 鉴权用，留空将拒绝所有请求）
ACCESS_TOKEN=change-me-please

# ===== Redis（云端 Docker）=====
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ===== LLM Providers（按需填写，对应 F-C-03）=====
GLM_API_KEY=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=

# ===== 人设系统（M3）=====
# 未绑定对象时使用的默认人设 id
PERSONA_ACTIVE_ID=default
# 人设 JSON 文件双写目录（相对项目根）
PERSONA_DIR=server/data/persona

# ===== 四级记忆系统（M3）=====
# 总开关，false 时降级为 M2 行为（不检索/不编码）
MEMORY_ENABLED=true
# 工作记忆滑窗轮数
MEMORY_WORKING_WINDOW=20
MEMORY_EPISODIC_ENABLE=true
# 每 N 轮触发一次 Episodic 摘要
MEMORY_EPISODIC_SUMMARIZE_THRESHOLD=12
# 每 N 次摘要触发一次反思
MEMORY_EPISODIC_REFLECT_INTERVAL=5
MEMORY_LONGTERM_ENABLE=true
# 长期记忆条目上限，超出触发遗忘淘汰
MEMORY_LONGTERM_MAX_FACTS=200
# 检索召回 top-K
MEMORY_RETRIEVE_TOPK=5
# 编码用 LLM provider/model（空则用对话同款 provider）
MEMORY_SUMMARY_PROVIDER=
MEMORY_SUMMARY_MODEL=
# 遗忘评分权重与阈值（docs/06 §6.1）
MEMORY_FORGET_W_IMPORTANCE=0.4
MEMORY_FORGET_W_RECENCY=0.3
MEMORY_FORGET_W_ACCESS=0.15
MEMORY_FORGET_W_EMOTION=0.15
MEMORY_FORGET_THRESHOLD=0.3
# recency 衰减半衰期（小时）
MEMORY_FORGET_HALFLIFE_HOURS=72

# ===== 多模态服务（M6 阶段填充，对应 F-C-07 / F-P-01~03）=====
TTS_API_KEY=
ASR_API_KEY=
IMAGE_GEN_API_KEY=

# ===== 客户端（指向服务端，重装系统后请确认服务器实际 IPv4）=====
CLIENT_SERVER_URL=http://<服务器IPv4>:8000
CLIENT_WS_URL=ws://<服务器IPv4>:8000/ws
